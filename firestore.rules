rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users: each user can read/write their own profile; profiles are readable
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    // Products: readable by everyone, writable for catalog management
    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    // Orders: allow customer checkout creation and lookup, seller fulfillment updates
    match /orders/{orderId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Default fallback for any other collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
